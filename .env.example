# Copy to .env for a local run. Never commit .env. On Railway these are service variables.
ASSEMBLYAI_API_KEY=

# Public demo limits (app/limits.py): Voice Agent calls cost money on this key
MAX_VOICE_CALLS=2
DAILY_AGENT_MINUTES=180
CALLS_PER_IP_PER_HOUR=8
# last day of the live demo, YYYY-MM-DD (empty = no end date)
DEMO_UNTIL=
MAX_SESSION_SECONDS=600
MAX_ROLEPLAY_SECONDS=600

# English subtitles for non-English turns (app/llm/clarify.py), through AssemblyAI's LLM Gateway
LLM_BASE_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
LLM_MODEL=qwen3.5-4b-32k-fast
LLM_MAX_PER_MINUTE=2

# Decision log (JSON lines): empty = eval/logs/decisions.jsonl, "off" = none (the default on Railway), or a file path
CARDEX_DECISION_LOG=
